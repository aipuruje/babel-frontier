# Production Environment Variables for Frontend
# This file should be created as .env.production with actual values

# API Configuration - Update with your actual backend URL after deployment
VITE_API_BASE_URL=https://your-production-api-url.com

# Environment
VITE_ENV=production

# Feature Flags
VITE_ENABLE_AI_TUTOR=true
VITE_ENABLE_VOICE_INPUT=false
VITE_ENABLE_CLANS=true
VITE_ENABLE_ANALYTICS=true

# Analytics & Monitoring (Optional - add your actual keys)
# PostHog Analytics
VITE_POSTHOG_KEY=your_posthog_project_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking
VITE_SENTRY_DSN=your_sentry_dsn_here

# Telegram Bot (for payment integration)
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
